# ─────────────────────────────────────────────────────────────
# 백엔드 API 호출
# 프론트는 same-origin으로 /api/v1/... 호출(Vite proxy → 백엔드 8081~8084).
# 별도 origin이 필요한 경우(예: 사내 dev에 배포된 백엔드 직접 호출)만 채운다.
# ─────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=

# 인증 우회 — 템플릿은 안전 기본값(false). 로컬 개발에서만 .env.development에서 true로 override.
# PKCE 정상 동작 확인 후 .env.development에서도 제거.
VITE_SKIP_AUTH=false

# ─────────────────────────────────────────────────────────────
# OIDC PKCE (Authentik / 운영기 Cognito)
# 값은 인프라 팀이 IdP 설정 시 발급. redirect_uri는 IdP에 등록한 값과 정확히 일치해야 함.
# ─────────────────────────────────────────────────────────────
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUTHORIZE_ENDPOINT=
VITE_OIDC_TOKEN_ENDPOINT=
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SCOPE=openid profile email
