# ─────────────────────────────────────────────────────────────
# 백엔드 API 호출
# 프론트는 same-origin으로 /api/v1/... 호출 → Vite proxy가 백엔드(8081~8084)로 reverse proxy.
# 별도 origin이 필요한 경우(예: 사내 dev에 배포된 백엔드 직접 호출)만 채운다.
# ─────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=

# 인증 우회 (개발 초기). PKCE 정상 동작 확인 후 false 또는 변수 제거.
VITE_SKIP_AUTH=false

# ─────────────────────────────────────────────────────────────
# OIDC PKCE (개발기 Authentik)
# 실제 값은 .env.local에서 override (.env.local은 git ignored — 비밀 값 보관용).
# 여기 값은 placeholder만 둔다.
# ─────────────────────────────────────────────────────────────
VITE_OIDC_CLIENT_ID=zT2Nkwd4Ui4hC26BYmsD6GywxmsTscruqtswkzq1
VITE_OIDC_AUTHORIZE_ENDPOINT=https://sso.sb.fisa/application/o/authorize/
VITE_OIDC_TOKEN_ENDPOINT=https://sso.sb.fisa/application/o/token/
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# scope에 gb-public-id 추가 — 백엔드가 토큰 custom claim public_id를 발급하려면 필요(이슈 #108 가드 SSOT).
VITE_OIDC_SCOPE=openid profile email gb-public-id

# ─────────────────────────────────────────────────────────────
# OIDC 로그아웃 (RP-Initiated Logout)
# end_session endpoint는 IdP의 OIDC discovery 문서에서 확인:
#   <issuer>/.well-known/openid-configuration → end_session_endpoint
# post_logout_redirect_uri는 IdP에 strict 등록된 값과 정확히 일치해야 함.
# ─────────────────────────────────────────────────────────────
VITE_OIDC_END_SESSION_ENDPOINT=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
