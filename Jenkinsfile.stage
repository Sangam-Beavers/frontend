// ─────────────────────────────────────────────────────────────
// front-app 배포 파이프라인 (stage) — 정적 빌드 → S3 + CloudFront
//
// Docker 이미지 버전(Jenkinsfile)과 달리, 정적 자산을 직접 빌드해 S3에 올린다.
// (S3엔 런타임 프로세스가 없어 placeholder 치환이 안 되므로, OIDC 값이 vite build 시점에
//  번들에 박혀야 한다. PS 값을 .env.production으로 생성 → vite build가 읽어 번들에 박음.)
//
// 배포 대상(버킷·distribution)도 하드코딩하지 않고 SSM Parameter Store에서 읽는다.
//
// Stage 1) Checkout (SCM)
// Stage 2) SonarQube 분석 + 품질 게이트
// Stage 3) OIDC 설정 주입: SSM(/sb/stage/frontend/VITE_OIDC_*) → .env.production
// Stage 4) 빌드: pnpm build (vite, production) → dist/  (.env.production 값이 번들에 박힘)
// Stage 5) S3 배포: 버킷명을 SSM에서 읽어 aws s3 sync --delete
// Stage 6) CloudFront 무효화: distribution id를 SSM에서 읽어 invalidation
//
// 자격증명: 'sb-stage-frontend-deploy' (S3 sync + SSM 읽기 + CloudFront 무효화 최소권한).
//   Vault → ExternalSecret → K8s Secret → Credentials Provider 플러그인(usernamePassword)으로 노출.
// ─────────────────────────────────────────────────────────────
pipeline {
  agent {
    kubernetes {
      yaml '''
        spec:
          containers:
          - name: scanner
            image: sonarsource/sonar-scanner-cli:latest
            command: ["sleep"]
            args: ["infinity"]
            securityContext:
              runAsUser: 0
          - name: node
            image: node:22
            command: ["sleep"]
            args: ["infinity"]
          - name: aws
            image: amazon/aws-cli:latest
            command: ["sleep"]
            args: ["infinity"]
      '''
    }
  }

  environment {
    AWS_DEFAULT_REGION = "ap-northeast-2"
    SSM_PREFIX         = "/sb/stage/frontend"
    HUSKY              = "0" // CI에선 git hook 설치 불필요 (pnpm install의 prepare 스킵)
    // Credentials Provider 플러그인이 노출한 자격증명 → AWS_CREDS_USR(키ID)/AWS_CREDS_PSW(시크릿)
    AWS_CREDS = credentials('sb-stage-frontend-deploy')
  }

  stages {
    stage('1) Checkout') {
      steps {
        checkout scm
      }
    }

    stage('2) SonarQube + 품질 게이트') {
      steps {
        container('scanner') {
          withSonarQubeEnv('sonarqube') {
            sh 'sonar-scanner'
          }
        }
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('3) OIDC 설정 주입 (SSM PS)') {
      steps {
        container('aws') {
          sh '''
            set -eo pipefail   # 파이프(aws | while) 앞단 실패도 즉시 표면화 — 가드 전에 진짜 원인 노출
            export AWS_ACCESS_KEY_ID="$AWS_CREDS_USR" AWS_SECRET_ACCESS_KEY="$AWS_CREDS_PSW"
            # PS의 VITE_OIDC_* → .env.production (vite build가 읽어 번들에 박음). 비-VITE 키는 제외.
            {
              aws ssm get-parameters-by-path --path "$SSM_PREFIX" --recursive \
                --query 'Parameters[].[Name,Value]' --output text \
                | while read -r name value; do
                    key=$(basename "$name")
                    case "$key" in VITE_*) echo "$key=$value" ;; esac
                  done
              echo "VITE_OIDC_SCOPE=openid profile email"   # Cognito엔 public_id 스코프 없음 (claim은 pre-token Lambda 주입)
              echo "VITE_SKIP_AUTH=false"
              echo "VITE_API_BASE_URL="                      # same-origin (CloudFront/nginx proxy)
            } > .env.production
            echo "=== .env.production (비밀 아님) ==="; cat .env.production
            # OIDC 값이 비면 (예: PS 읽기 실패) 하얀화면 대신 여기서 명확히 실패
            grep -q '^VITE_OIDC_CLIENT_ID=.' .env.production || { echo "ERROR: OIDC PS 값 누락 — /sb/stage/frontend/VITE_OIDC_* 확인"; exit 1; }
          '''
        }
      }
    }

    stage('4) 빌드 (vite, 정적)') {
      steps {
        container('node') {
          sh '''
            set -e
            corepack enable
            corepack prepare pnpm@11.5.1 --activate   # 락파일(v9) 생성 버전에 핀 — 재현성
            pnpm install --frozen-lockfile
            pnpm build          # tsc -b && vite build — .env.production 의 VITE_OIDC_* 가 번들에 박힘
            ls -la dist
          '''
        }
      }
    }

    stage('5) S3 배포') {
      steps {
        container('aws') {
          sh '''
            set -e
            export AWS_ACCESS_KEY_ID="$AWS_CREDS_USR" AWS_SECRET_ACCESS_KEY="$AWS_CREDS_PSW"
            BUCKET=$(aws ssm get-parameter --name "$SSM_PREFIX/SPA_BUCKET" --query Parameter.Value --output text)
            echo "bucket: $BUCKET"
            aws s3 sync dist/ "s3://$BUCKET/" --delete
          '''
        }
      }
    }

    stage('6) CloudFront 무효화') {
      steps {
        container('aws') {
          sh '''
            set -e
            export AWS_ACCESS_KEY_ID="$AWS_CREDS_USR" AWS_SECRET_ACCESS_KEY="$AWS_CREDS_PSW"
            DIST=$(aws ssm get-parameter --name "$SSM_PREFIX/CLOUDFRONT_DISTRIBUTION_ID" --query Parameter.Value --output text)
            ID=$(aws cloudfront create-invalidation --distribution-id "$DIST" --paths '/*' --query 'Invalidation.Id' --output text)
            echo "distribution: $DIST / invalidation: $ID"
          '''
        }
      }
    }
  }

  post {
    success {
      echo "✅ 배포 완료 — CloudFront 무효화 1~5분 후 반영"
    }
    failure {
      echo "❌ 실패 — Console Output에서 stage 확인"
    }
  }
}
