# ─────────────────────────────────────────────────────────────
# 프로덕션 빌드용 — 모든 환경 공통 빌드 시 사용됨
# Vite가 빌드 시 placeholder 문자열을 dist/assets/*.js에 박아넣고,
# 컨테이너 시작 시 docker-entrypoint.sh가 환경변수로 sed 치환.
# 같은 이미지로 dev/stage/prod 다 사용.
#
# ⚠️ 이 파일은 placeholder만 있어 안전하게 커밋함.
#    Docker 빌드 중에 .env.production으로 복사되어 vite build에 사용됨.
#    팀원의 로컬 .env.production (gitignored)는 영향 없음.
# ─────────────────────────────────────────────────────────────

# API는 same-origin (nginx proxy로 백엔드 라우팅) — 비워둠
VITE_API_BASE_URL=

# 인증 우회 여부 — 런타임 치환
VITE_SKIP_AUTH=__SKIP_AUTH__

# OIDC PKCE — 런타임 치환
VITE_OIDC_CLIENT_ID=__OIDC_CLIENT_ID__
VITE_OIDC_AUTHORIZE_ENDPOINT=__OIDC_AUTHORIZE_ENDPOINT__
VITE_OIDC_TOKEN_ENDPOINT=__OIDC_TOKEN_ENDPOINT__
VITE_OIDC_REDIRECT_URI=__OIDC_REDIRECT_URI__
VITE_OIDC_SCOPE=openid profile email gb-public-id

# OIDC 로그아웃 — 런타임 치환
VITE_OIDC_END_SESSION_ENDPOINT=__OIDC_END_SESSION_ENDPOINT__
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=__OIDC_POST_LOGOUT_REDIRECT_URI__
