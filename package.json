{
  "name": "front-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "gen:types": "pnpm gen:types:member && pnpm gen:types:wallet && pnpm gen:types:community && pnpm gen:types:document",
    "gen:types:member": "openapi-typescript http://localhost:8081/v3/api-docs -o src/types/api/member.ts",
    "gen:types:wallet": "openapi-typescript http://localhost:8084/v3/api-docs -o src/types/api/wallet.ts",
    "gen:types:community": "openapi-typescript http://localhost:8082/v3/api-docs -o src/types/api/community.ts",
    "gen:types:document": "openapi-typescript http://localhost:8083/v3/api-docs -o src/types/api/document.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "axios": "^1.16.1",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ],
    "**/*.js": [
      "prettier --write"
    ]
  }
}
